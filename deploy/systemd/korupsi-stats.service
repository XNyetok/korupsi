[Unit]
Description=Korupsi telemetry collector
Documentation=https://github.com/XNyetok/korupsi
After=network.target

[Service]
Type=simple
User=korupsi
Group=korupsi
# "current" is a symlink the deploy switches, like the site's. systemd resolves
# it when the service starts, so a restart picks up the new release.
WorkingDirectory=/opt/korupsi-stats/current
Environment=PORT=8787
Environment=HOST=127.0.0.1
Environment=DB_PATH=/var/lib/korupsi-stats/stats.db
# The GeoIP file, put there by hand and replaced monthly (docs/deploy.md).
Environment=GEO_DB=/opt/korupsi-stats/geo/city.mmdb
ExecStart=/usr/bin/node /opt/korupsi-stats/current/index.mjs
Restart=on-failure
RestartSec=3

# The service only needs to read its code and write its database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/korupsi-stats

[Install]
WantedBy=multi-user.target
